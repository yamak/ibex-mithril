name: "lowrisc:ibex:fpga_xilinx_shared"
description: "Collection of useful RTL for Xilinx based examples"
filesets:
  files_sv:
    depend:
      - lowrisc:prim:ram_2p
    files:
      - rtl/fpga/xilinx/clkgen_xil7series.sv
      - rtl/ram_2p.sv
      - rtl/ram_1p.sv
      - rtl/bus.sv
      - rtl/timer.sv
      - rtl/xorshift128_prng.sv
      - rtl/qarma64_enc_core.sv
    file_type: systemVerilogSource

  files_vhdl:
    files:
      - rtl/neoTRNG.vhd
    file_type: vhdlSource

targets:
  default:
    filesets:
      - files_sv
      - files_vhdl
